      "plugin_source": "\"\"\"Linux-only controlled delay experiment; no application source modification.\"\"\"\nimport subprocess\nimport sys\nimport pytest\n\n@pytest.fixture(autouse=True)\ndef delay_actual_children(request, monkeypatch):\n    if request.node.name != 'test_separate_cli_process_asks_while_ingestion_and_summaries_continue':\n        return\n    original = subprocess.Popen\n    def delayed_popen(args, *positional, **kwargs):\n        delay = 13 if any(str(arg).endswith('capture.py') for arg in args) else 21\n        # exec preserves the process identity and executes the original Python CLI arguments.\n        code = 'import os,sys,time;time.sleep(float(sys.argv[1]));os.execv(sys.executable,[sys.executable]+sys.argv[2:])'\n        return original([sys.executable, '-c', code, str(delay), *args[1:]], *positional, **kwargs)\n    monkeypatch.setattr(subprocess, 'Popen', delayed_popen)\n",
