      "plugin_source": "\"\"\"Linux integration experiment: launcher waits for a real interpreter child.\"\"\"\nimport subprocess\nimport sys\nimport pytest\n\n@pytest.fixture(autouse=True)\ndef redirect_capture(request, monkeypatch):\n    if request.node.name != 'test_separate_cli_process_asks_while_ingestion_and_summaries_continue':\n        return\n    original = subprocess.Popen\n    def redirected_popen(args, *positional, **kwargs):\n        if any(str(arg).endswith('capture.py') for arg in args):\n            code = 'import subprocess,sys;sys.exit(subprocess.call([sys.executable]+sys.argv[1:]))'\n            return original([sys.executable, '-c', code, *args[1:]], *positional, **kwargs)\n        return original(args, *positional, **kwargs)\n    monkeypatch.setattr(subprocess, 'Popen', redirected_popen)\n",
